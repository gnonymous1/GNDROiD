# Binaries and executables
*.exe
*.dll
*.iso
*.qcow2
*.img
target/
dist/
nextgen-android-emulator/

# Unignore official turnkey installer and bundled tools
!gndroid.exe
!installer/*.exe
!tools/*
!tools/*.exe
!tools/*.dll

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Runtime and temp files
logs/
virtual_storage/
*.log
*.tmp
.agents/

build/
