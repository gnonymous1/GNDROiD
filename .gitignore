# Binaries and executables
*.exe
*.dll
*.iso
*.qcow2
*.img
target/
dist/
nextgen-android-emulator/

# Unignore official turnkey installer and bundled tools
!gndroid.exe
!installer/*.exe
!tools/*
!tools/*.exe
!tools/*.dll

# Cryptographic Keys, Keystores & Certificates (Do NOT commit secrets!)
*.keystore
*.jks
*.p12
*.key
*.pem
*.pfx
secrets/
*.secret

# Environment variables & credentials
.env
.env.local
.env.*.local
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Runtime, temporary files & internal session handovers
logs/
virtual_storage/
*.log
*.tmp
.agents/
SESSION_*.md
.gemini/

build/
