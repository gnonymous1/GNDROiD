cc_binary {
    name: "android.hardware.security.keymint-service.indusbridge",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.security.keymint-service.indusbridge.rc"],
    vintf_fragments: ["android.hardware.security.keymint-service.indusbridge.xml"],
    srcs: [
        "VirtualKeyMintDevice.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.security.keymint-V3-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "libcrypto",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
