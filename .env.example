# ======================================================================
# GNDROiD — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local/CI secrets.
# NEVER commit your real .env file or signing keys to version control!
# ======================================================================

# Android SDK Path (Auto-detected if standard)
# ANDROID_HOME=C:\Users\<Username>\AppData\Local\Android\Sdk
# ANDROID_SDK_ROOT=C:\Users\<Username>\AppData\Local\Android\Sdk

# Companion APK Production Signing (Stored in GitHub Secrets for CI/CD)
# GNDROID_KEYSTORE_PATH=path/to/release.keystore
# GNDROID_KEYSTORE_PASS=your_secure_keystore_password
# GNDROID_KEY_ALIAS=gndroid
# GNDROID_KEY_PASS=your_secure_key_password

# Telemetry & Diagnostic Logging Level (DEBUG, INFO, WARNING, ERROR)
GNDROID_LOG_LEVEL=INFO

# Default Network Bridging Target Adapter (Optional override)
# GNDROID_DEFAULT_ADAPTER=Wi-Fi

# Remote Companion Stream Port (Default: 51888)
# GNDROID_STREAM_PORT=51888
